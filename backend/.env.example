# ===========================================
# BACKEND ENVIRONMENT VARIABLES - TEMPLATE
# ===========================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------
# SUPABASE (REQUIRED)
# -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------
# EMAIL SERVICE (REQUIRED for OTP & Winner Emails)
# -----------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Use a verified sending domain in production (recommended): no-reply@yourdomain.com
RESEND_FROM_EMAIL=no-reply@yourdomain.com
# Optional reply-to address for customer responses
RESEND_REPLY_TO_EMAIL=support@yourdomain.com

# -----------------------------------------
# NEXTAUTH (REQUIRED for Admin Authentication)
# -----------------------------------------
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (get from: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@example.com,admin2@example.com

# -----------------------------------------
# API URLs
# -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
PORT=3001

# -----------------------------------------
# RAZORPAY (OPTIONAL - for online payments)
# -----------------------------------------
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------
# TWILIO (OPTIONAL - for Phone OTP Verification)
# -----------------------------------------
# Get from: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# -----------------------------------------
# CRON JOB SETTINGS (OPTIONAL)
# -----------------------------------------
# CRON_SECRET=your_cron_secret_here

# -----------------------------------------
# STORAGE (OPTIONAL)
# -----------------------------------------
# SUPABASE_REEL_BUCKET=auction-media

# -----------------------------------------
# ENVIRONMENT
# -----------------------------------------
NODE_ENV=development
